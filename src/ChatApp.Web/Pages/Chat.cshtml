@page
@model ChatModel
@{
    ViewData["Title"] = "Chatroom";
}

<div class="chat-container">
    <div class="chat-header">
        <h1>#general</h1>
        <span id="connection-status" class="status connecting">connecting…</span>
    </div>
    <ul id="message-list" class="message-list"></ul>
    <form id="message-form" class="message-form" autocomplete="off">
        <input id="message-input" maxlength="500"
               placeholder="Type a message, or /stock=aapl.us for a quote" />
        <button type="submit">Send</button>
    </form>
</div>

<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/js/chat.js"></script>
